+static int
+drm_clone_state_apply_atomic(int fd_id, drmModeAtomicReq *req,
+			      struct drm_backend *b, int index)
+{
+	int fd_drm = b->drm->drm.fd;
+	uint32_t conn_id = b->clone_info[index].conn_id;
+	uint32_t crtc_id = b->clone_info[index].crtc_id;
+	uint32_t plane_id = b->clone_info[index].plane_id;
+	uint32_t width = b->clone_info[index].mode.hdisplay;
+	uint32_t height = b->clone_info[index].mode.vdisplay;
+
+	drmModeObjectProperties *props;
+	uint32_t property_crtc_id;
+	uint32_t property_active;
+	uint32_t property_mode_id;
+	uint32_t property_crtc_x;
+	uint32_t property_crtc_y;
+	uint32_t property_crtc_w;
+	uint32_t property_crtc_h;
+	uint32_t property_src_x;
+	uint32_t property_src_y;
+	uint32_t property_src_w;
+	uint32_t property_src_h;
+	uint32_t property_fb_id;
+	uint32_t blob_id;
+
+	props = drmModeObjectGetProperties(fd_drm, conn_id, DRM_MODE_OBJECT_CONNECTOR);
+	property_crtc_id = get_property_id(fd_drm, props, "CRTC_ID");
+	drmModeFreeObjectProperties(props);
+
+	drmModeCreatePropertyBlob(fd_drm, &b->clone_info[index].mode,
+			sizeof(b->clone_info[index].mode), &blob_id);
+
+	props = drmModeObjectGetProperties(fd_drm, crtc_id, DRM_MODE_OBJECT_CRTC);
+	property_active = get_property_id(fd_drm, props, "ACTIVE");
+	property_mode_id = get_property_id(fd_drm, props, "MODE_ID");
+	drmModeFreeObjectProperties(props);
+
+	drmModeAtomicAddProperty(req, crtc_id, property_active, 1);
+	drmModeAtomicAddProperty(req, conn_id, property_crtc_id, crtc_id);
+	drmModeAtomicAddProperty(req, crtc_id, property_mode_id, blob_id);
+
+	props = drmModeObjectGetProperties(fd_drm, plane_id, DRM_MODE_OBJECT_PLANE);
+	property_crtc_id = get_property_id(fd_drm, props, "CRTC_ID");
+	property_fb_id = get_property_id(fd_drm, props, "FB_ID");
+	property_crtc_x = get_property_id(fd_drm, props, "CRTC_X");
+	property_crtc_y = get_property_id(fd_drm, props, "CRTC_Y");
+	property_crtc_w = get_property_id(fd_drm, props, "CRTC_W");
+	property_crtc_h = get_property_id(fd_drm, props, "CRTC_H");
+	property_src_x = get_property_id(fd_drm, props, "SRC_X");
+	property_src_y = get_property_id(fd_drm, props, "SRC_Y");
+	property_src_w = get_property_id(fd_drm, props, "SRC_W");
+	property_src_h = get_property_id(fd_drm, props, "SRC_H");
+	drmModeFreeObjectProperties(props);
+
+	drmModeAtomicAddProperty(req, plane_id, property_crtc_id, crtc_id);
+	drmModeAtomicAddProperty(req, plane_id, property_fb_id, fd_id);
+	drmModeAtomicAddProperty(req, plane_id, property_crtc_x, 0);
+	drmModeAtomicAddProperty(req, plane_id, property_crtc_y, 0);
+	drmModeAtomicAddProperty(req, plane_id, property_crtc_w, width);
+	drmModeAtomicAddProperty(req, plane_id, property_crtc_h, height);
+	drmModeAtomicAddProperty(req, plane_id, property_src_x, 0);
+	drmModeAtomicAddProperty(req, plane_id, property_src_y, 0);
+	drmModeAtomicAddProperty(req, plane_id, property_src_w, width << 16);
+	drmModeAtomicAddProperty(req, plane_id, property_src_h, height << 16);
+
+	return 0;
+}
