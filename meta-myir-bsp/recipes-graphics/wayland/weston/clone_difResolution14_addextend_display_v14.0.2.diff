+static void
+clone_mode_g2d_blit(struct weston_compositor *ec, struct g2d_surfaceEx* srcg2dSurface, struct g2d_surfaceEx* dstg2dSurface)
+{
+	struct g2d_renderer *gr = get_renderer(ec);
+
+	srcg2dSurface->base.left = 0;
+	srcg2dSurface->base.right = srcg2dSurface->base.width;
+	srcg2dSurface->base.top = 0;
+	srcg2dSurface->base.bottom = srcg2dSurface->base.height;
+	srcg2dSurface->base.width = srcg2dSurface->base.width;
+	srcg2dSurface->base.height = srcg2dSurface->base.height;
+	srcg2dSurface->base.blendfunc = G2D_ONE;
+
+	if (dstg2dSurface->base.width < dstg2dSurface->base.height &&
+	    srcg2dSurface->base.width > srcg2dSurface->base.height) {
+		dstg2dSurface->base.rot = G2D_ROTATION_270;
+	} else {
+		dstg2dSurface->base.rot = G2D_ROTATION_0;
+	}
+	dstg2dSurface->base.blendfunc = G2D_ONE_MINUS_SRC_ALPHA;
+	dstg2dSurface->base.left = 0;
+	dstg2dSurface->base.right = dstg2dSurface->base.width;
+	dstg2dSurface->base.top = 0;
+	dstg2dSurface->base.bottom = dstg2dSurface->base.height;
+	dstg2dSurface->base.width = dstg2dSurface->base.width;
+	dstg2dSurface->base.height = dstg2dSurface->base.height;
+
+	g2d_set_clipping(gr->handle, 0, 0, dstg2dSurface->base.right, dstg2dSurface->base.height);
+
+	g2d_blitEx(gr->handle, srcg2dSurface, dstg2dSurface);
+	g2d_flush(gr->handle);
+	g2d_finish(gr->handle);
+}
