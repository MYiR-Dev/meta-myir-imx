+static uint32_t
+get_property_id(int fd_drm, drmModeObjectProperties *props, const char *prop_name)
+{
+	drmModePropertyPtr property;
+	uint32_t id = 0;
+
+	for (uint32_t i = 0; i < props->count_props; i++) {
+		property = drmModeGetProperty(fd_drm, props->props[i]);
+		if (!strcmp(property->name, prop_name))
+			id = property->prop_id;
