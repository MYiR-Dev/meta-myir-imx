# short-description: MYD-Y6ULL eMMC SD card image with U-Boot environment at fixed MMC offsets
# long-description: Creates a partitioned image for MYD-Y6ULL 14x14 eMMC boards.
#   Partition layout:
#     u-boot (rawcopy)   @ 1KB   (0x400)    — u-boot.imx.tagged
#     u-boot env primary @ 896KB (0xE0000)   — u-boot-env.bin (8KB, CRC32)
#     u-boot env redundant@ 904KB (0xE2000)  — u-boot-env.bin (8KB, CRC32)
#     /boot (FAT)        @ 4MB   (0x400000)  — kernel, DTB, OP-TEE
#     / (ext4)           after /boot          — rootfs

part u-boot --source rawcopy --sourceparams="file=u-boot.imx.tagged" --ondisk mmcblk --no-table --align 1
part u-boot-env --source rawcopy --sourceparams="file=u-boot-env.bin" --ondisk mmcblk --no-table --offset 896K
part u-boot-env-red --source rawcopy --sourceparams="file=u-boot-env.bin" --ondisk mmcblk --no-table --offset 904K
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 4096 --size 28
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --align 4096 --use-uuid

bootloader --ptable msdos
