# Based on meta-freescale/wic/imx-imx-boot-bootpart.wks.in
#
# short-description: Create SD card image with signed boot container (AHAB)
# long-description:
# Security image for MYIR i.MX95 platforms.
# Uses AHAB-signed imx-boot container (imx-boot-signed) +
# standard ext4 rootfs (no dm-verity).
# Intended for secure boot without rootfs integrity protection.
#
# The disk layout used is:
#  - --------------- -------------- --------------
# | | imx-boot-signed|     boot     |    rootfs    |
#  - --------------- -------------- --------------
# ^ ^               ^              ^              ^
# | |               |              |              |
# 0 |             8MiB          264MiB         264MiB + rootfs + IMAGE_EXTRA_SPACE (default 10MiB)
#   ${IMX_BOOT_SEEK} = 32 (i.MX95)
#
# Partition 1: imx-boot-signed (AHAB container, raw at offset ${IMX_BOOT_SEEK})
# Partition 2: /boot (FAT, kernel FIT image + DTBs)
# Partition 3: / (ext4 rootfs)
#
part u-boot --source rawcopy --sourceparams="file=imx-boot-signed" --ondisk mmcblk --no-table --align ${IMX_BOOT_SEEK}
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 8192 --fixed-size 280
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --align 8192

bootloader --ptable msdos
