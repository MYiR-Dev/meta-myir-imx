# short-description: SD card image with dm-verity rootfs + encrypted data partition
# long-description:
# Security image for MYIR i.MX95 platforms with AHAB + FIT + dm-verity + dm-crypt.
#
# Chain of trust:
#   AHAB(boot container) -> FIT verified boot(kernel+initramfs) -> dm-verity(rootfs)
#                                                            -> dm-crypt(data partition)
#
# Partition layout:
#  - ---------- -------------- ------------------------------- ------------------
# | | imx-boot |     boot     |   rootfs (dm-verity rawcopy)  |  data (enc)      |
#  - ---------- -------------- ------------------------------- ------------------
# ^ ^          ^              ^                                ^                  ^
# | |          |              |                                |                  |
# 0 |        8MiB          264MiB                      264MiB+rootfs       end of disk
#    = 32 (i.MX95)
#
# Partition 1: imx-boot    (AHAB container, raw at offset )
# Partition 2: /boot        (FAT, kernel FIT image + DTBs)
# Partition 3: /             (dm-verity rootfs, raw copy of .ext4.verity image)
# Partition 4: /run/encdata  (dm-crypt data, formatted + encrypted at first boot)
#
part u-boot --source rawcopy --sourceparams="file=imx-boot.tagged" --ondisk mmcblk --no-table --align ${IMX_BOOT_SEEK}
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 8192 --fixed-size 256
part / --source rawcopy --ondisk mmcblk --sourceparams="file=${IMGDEPLOYDIR}/${DM_VERITY_IMAGE}-${MACHINE}${IMAGE_NAME_SUFFIX}.${DM_VERITY_IMAGE_TYPE}.verity" --fixed-size 4096
part /run/encdata --ondisk mmcblk --fstype=ext4 --label encdata

bootloader --ptable msdos
