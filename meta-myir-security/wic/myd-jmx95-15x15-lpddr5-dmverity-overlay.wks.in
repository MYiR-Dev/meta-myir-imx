# myd-jmx95-15x15-lpddr5-dmverity-overlay.wks.in
#
# short-description: SD card image with dm-verity rootfs + overlay partition
# long-description:
# Security image for MYIR i.MX95 platforms with dm-verity + overlayfs.
# Uses AHAB-signed imx-boot container + FIT-signed kernel +
# dm-verity integrity-protected rootfs + overlay partition for
# writable /etc, /root, /var via overlayfs.
#
# Based on NXP meta-security-imx-dmverity:
#   wic/imx-imx-boot-bootpart-dmverity-hash-overlay.wks.in
#
# The disk layout used is:
#  - ---------- -------------- ------------------------------- --------------
# | | imx-boot |     boot     |   rootfs (dm-verity rawcopy)  |   overlay   |
#  - ---------- -------------- ------------------------------- --------------
# ^ ^          ^              ^                                ^
# | |          |              |                                |
# 0 |        8MiB          264MiB                      (auto)    ${MYIR_OVERLAY_PARTITION_SIZE}
#   ${IMX_BOOT_SEEK} = 32 (i.MX95)
#
# Partition 1: imx-boot  (AHAB container, raw at offset ${IMX_BOOT_SEEK})
# Partition 2: /boot      (FAT, kernel FIT image + DTBs, fixed 256 MiB)
# Partition 3: /           (dm-verity rootfs, size auto from .verity file)
# Partition 4: overlay    (ext4, writable, for overlayfs upper/work dirs)
#
# Variables:
#   MYIR_OVERLAY_PARTITION_SIZE: overlay partition size in MiB (default: 2048)
#

part u-boot --source rawcopy --sourceparams="file=imx-boot-signed" --ondisk mmcblk --no-table --align ${IMX_BOOT_SEEK}
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 8192 --fixed-size 256
part / --source rawcopy --ondisk mmcblk --sourceparams="file=${IMGDEPLOYDIR}/${DM_VERITY_IMAGE}-${MACHINE}${IMAGE_NAME_SUFFIX}.${DM_VERITY_IMAGE_TYPE}.verity"
part overlay --ondisk mmcblk --fstype=ext4 --label overlay --align 8192 --size ${MYIR_OVERLAY_PARTITION_SIZE}

bootloader --ptable msdos
