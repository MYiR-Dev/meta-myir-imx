SUMMARY = "MYIR DM-Verity Initramfs Image"
DESCRIPTION = "Minimal ramdisk image to verify and mount a dm-verity protected rootfs on MYIR i.MX95 platforms"

LICENSE = "MIT"

# Force IMAGE_BASENAME to avoid any machine-specific appends that
# could cause mismatches with INITRAMFS_IMAGE_NAME.
export IMAGE_BASENAME
python () {
    d.setVar('IMAGE_BASENAME', 'myir-initramfs-dmverity')
}

IMAGE_NAME_SUFFIX ?= ""
IMAGE_LINGUAS = ""

# Initramfs modules required for dm-verity boot:
#   initramfs-framework-base  - base initramfs framework
#   initramfs-module-udev     - udev support for device detection
#   initramfs-module-dmverity - reads dm-verity.env and sets up dm-verity
INITRAMFS_SCRIPTS ?= "\
    initramfs-framework-base \
    initramfs-module-udev \
    initramfs-module-dmverity \
"

PACKAGE_INSTALL = "\
    ${INITRAMFS_SCRIPTS} \
    ${VIRTUAL-RUNTIME_base-utils} \
    udev \
    cryptsetup \
"

# Do not mount rootfs directly (we mount via dm-verity instead)
BAD_RECOMMENDATIONS += "initramfs-module-rootfs"

IMAGE_FEATURES = ""

# Avoid circular dependencies: the ramdisk does not need the bootloader
DEPENDS:remove = "\
    u-boot-default-script \
    virtual/bootloader \
    imx-boot \
    virtual/dtb \
"

# --------------------------------------------------------------------------
# CRITICAL: Two-pass build required.
#
# We CANNOT add "do_rootfs[depends] += '${DM_VERITY_IMAGE}:do_image_complete'"
# because that creates a circular dependency:
#   initramfs → rootfs-image → kernel-packages → kernel-deploy → initramfs
#
# Instead, use the documented two-pass workflow:
#   Pass 1: bitbake myir-image-emmc    # builds rootfs, generates .verity.env
#   Pass 2: bitbake myir-image-emmc    # picks up .verity.env, embeds in FIT
#
# --------------------------------------------------------------------------
# Always rebuild the ramdisk when DM_VERITY_IMAGE changes
# (since the root hash changes with every rootfs build)
do_image[nostamp] = "1"

IMAGE_FSTYPES = "${INITRAMFS_FSTYPES}"

inherit core-image

IMAGE_ROOTFS_SIZE = "8192"
IMAGE_ROOTFS_EXTRA_SPACE = "0"

# Deploy the dm-verity root hash environment file into the ramdisk.
# The initramfs-module-dmverity reads /usr/share/misc/dm-verity.env
# to obtain the root hash and verity parameters.
#
# On first pass (no .verity.env yet): creates a harmless placeholder
# so the build doesn't fail.  The actual root hash is embedded on
# the second pass after DM_VERITY_IMAGE has been built.
deploy_verity_hash() {
    ENV_FILE=$(ls ${STAGING_VERITY_DIR}/*.${DM_VERITY_IMAGE_TYPE}.verity.env 2>/dev/null | head -1)
    if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
        bbnote "myir-initramfs: embedding dm-verity root hash from $ENV_FILE"
        install -D -m 0644 "$ENV_FILE" ${IMAGE_ROOTFS}${datadir}/misc/dm-verity.env
    else
        bbwarn "myir-initramfs: NO dm-verity.env found in ${STAGING_VERITY_DIR}"
        bbwarn "This is expected on the FIRST build pass."
        bbwarn "Run 'bitbake ${DM_VERITY_IMAGE}' first, then rebuild."
        # Create a placeholder so initramfs-module-dmverity won't crash
        # (the real file will be embedded on the second pass)
        mkdir -p ${IMAGE_ROOTFS}${datadir}/misc
        echo "# PLACEHOLDER - rebuild after DM_VERITY_IMAGE is complete" > \
            ${IMAGE_ROOTFS}${datadir}/misc/dm-verity.env
    fi
}
IMAGE_PREPROCESS_COMMAND += "deploy_verity_hash;"
