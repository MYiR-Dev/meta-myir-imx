SUMMARY = "MYIR DM-Verity Initramfs Image"
DESCRIPTION = "Minimal ramdisk image to verify and mount a dm-verity protected \
rootfs on MYIR i.MX95 platforms.  Includes optional root hash signature \
verification and overlayfs for writable /etc, /root, /var."

LICENSE = "MIT"

# Force IMAGE_BASENAME to avoid any machine-specific appends that
# could cause mismatches with INITRAMFS_IMAGE_NAME.
export IMAGE_BASENAME
python () {
    d.setVar('IMAGE_BASENAME', 'myir-initramfs-dmverity')
}

IMAGE_NAME_SUFFIX ?= ""
IMAGE_LINGUAS = ""

# ============================================================================
# Initramfs modules
#
# Module order in initramfs-framework:
#   01-udev       → device detection
#   10-e2fs       → ext4 filesystem support
#   89-dmverity-overlay → dm-verity + overlay setup (runs before 90-rootfs)
#   99-finish     → final boot handoff
#
# When overlay is enabled, we use our enhanced dmverity-overlay module
# which replaces both initramfs-module-dmverity and initramfs-module-rootfs.
# When overlay is disabled, we fall back to the upstream dmverity module
# from meta-security.
# ============================================================================

INITRAMFS_SCRIPTS ?= " \
    initramfs-framework-base \
    initramfs-module-udev \
    ${@'initramfs-module-dmverity-overlay' if d.getVar('MYIR_DM_VERITY_OVERLAY') == '1' else 'initramfs-module-dmverity initramfs-module-rootfs'} \
"

# ============================================================================
# Package installation
#
# When MYIR_DM_VERITY_OVERLAY is enabled:
#   - We use dmverity-overlay which handles root mount itself, so
#     initramfs-module-rootfs is NOT needed (BAD_RECOMMENDATIONS removes it).
#
# When MYIR_DM_VERITY_SIGN_ROOTHASH is enabled:
#   - openssl-bin is required for runtime signature verification.
# ============================================================================
PACKAGE_INSTALL = " \
    ${INITRAMFS_SCRIPTS} \
    ${VIRTUAL-RUNTIME_base-utils} \
    udev \
    cryptsetup \
    ${@bb.utils.contains('MYIR_DM_VERITY_OVERLAY', '1', 'util-linux-mount', '', d)} \
    ${@bb.utils.contains('MYIR_DM_VERITY_SIGN_ROOTHASH', '1', 'openssl-bin', '', d)} \
    ${@bb.utils.contains('MYIR_DM_VERITY_OVERLAY', '1', 'e2fsprogs-mke2fs', '', d)} \
"

# Remove default rootfs module when overlay handles root mount
BAD_RECOMMENDATIONS += "${@'initramfs-module-rootfs' if d.getVar('MYIR_DM_VERITY_OVERLAY') == '1' else ''}"

IMAGE_FEATURES = ""

# Avoid circular dependencies: the ramdisk does not need the bootloader
DEPENDS:remove = " \
    u-boot-default-script \
    virtual/bootloader \
    imx-boot \
    virtual/dtb \
"

# ============================================================================
# Build workflow
#
# The dm-verity root hash is generated during do_image_complete of
# the DM_VERITY_IMAGE (myir-image-emmc).  The initramfs picks up:
#   - dm-verity.env       (root hash + verity params)
#   - dm-verity-public.pem (RSA public key, if signing enabled)
#   - dm-verity-roothash.sig (root hash signature, if signing enabled)
#
# from STAGING_VERITY_DIR during do_image.
#
# RECOMMENDED BUILD FLOW (cleansstate approach):
#   Pass 1: bitbake myir-image-emmc
#           → generates .verity.env + signature in STAGING_VERITY_DIR
#   Pass 2: bitbake myir-initramfs-dmverity -c cleansstate
#           bitbake myir-image-emmc
#           → initramfs picks up correct hash + signature
#           → FIT image rebuilt with updated initramfs
#           → WIC image assembled
# ============================================================================
do_image[nostamp] = "1"

# Force initramfs.do_image to wait for rootfs.do_image_ext4
# which writes ROOT_HASH + signature to STAGING_VERITY_DIR.
# Without this, BitBake may build initramfs before rootfs,
# reading stale hash data from a previous build.
do_image[depends] += "${DM_VERITY_IMAGE}:do_image_${DM_VERITY_IMAGE_TYPE}"

IMAGE_FSTYPES = "${INITRAMFS_FSTYPES}"

inherit core-image

IMAGE_ROOTFS_SIZE = "8192"
IMAGE_ROOTFS_EXTRA_SPACE = "0"

# ============================================================================
# deploy_verity_hash()
#
# Deploy dm-verity artifacts into the initramfs:
#   1. dm-verity.env     — root hash, data size, block size, etc.
#   2. dm-verity-public.pem — RSA public key (if signing enabled)
#   3. dm-verity-roothash.sig — root hash signature (if signing enabled)
#
# On first pass (no .verity.env yet): creates placeholder files
# so the build doesn't fail.  The real files are embedded on the
# second pass after DM_VERITY_IMAGE has been built.
# ============================================================================
deploy_verity_hash() {
    ENV_FILE=$(ls ${STAGING_VERITY_DIR}/*.${DM_VERITY_IMAGE_TYPE}.verity.env 2>/dev/null | head -1)

    # Create target directory
    mkdir -p ${IMAGE_ROOTFS}${datadir}/misc

    if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
        bbnote "myir-initramfs: embedding dm-verity root hash from $ENV_FILE"
        install -m 0644 "$ENV_FILE" ${IMAGE_ROOTFS}${datadir}/misc/dm-verity.env

        ROOT_HASH_VAL=$(grep "^ROOT_HASH=" "$ENV_FILE" | cut -d= -f2)
        bbnote "myir-initramfs:   ROOT_HASH = ${ROOT_HASH_VAL}"

        # Deploy root hash signature (if signing enabled)
        if [ "${MYIR_DM_VERITY_SIGN_ROOTHASH}" = "1" ]; then
            SIG_FILE="${STAGING_VERITY_DIR}/roothash.sig"
            if [ -f "$SIG_FILE" ]; then
                install -m 0644 "$SIG_FILE" ${IMAGE_ROOTFS}${datadir}/misc/dm-verity-roothash.sig
                bbnote "myir-initramfs:   deployed roothash.sig"
            else
                bbwarn "myir-initramfs: roothash.sig not found in ${STAGING_VERITY_DIR}"
            fi

            PUBKEY_FILE="${STAGING_VERITY_DIR}/public_key.pem"
            if [ -f "$PUBKEY_FILE" ]; then
                install -m 0644 "$PUBKEY_FILE" ${IMAGE_ROOTFS}${datadir}/misc/dm-verity-public.pem
                bbnote "myir-initramfs:   deployed public_key.pem"
            else
                bbwarn "myir-initramfs: public_key.pem not found in ${STAGING_VERITY_DIR}"
            fi
        fi
    else
        bbwarn "myir-initramfs: NO dm-verity.env found in ${STAGING_VERITY_DIR}"
        bbwarn "This is expected on the FIRST build pass (cleansstate workflow)."
        bbwarn "Run 'bitbake ${DM_VERITY_IMAGE}' first to generate the root hash,"
        bbwarn "then run 'bitbake myir-initramfs-dmverity -c cleansstate' before the"
        bbwarn "second 'bitbake ${DM_VERITY_IMAGE}'."

        # Create a placeholder so the initramfs doesn't break
        echo "# PLACEHOLDER - rebuild after DM_VERITY_IMAGE build" > \
            ${IMAGE_ROOTFS}${datadir}/misc/dm-verity.env
        echo "ROOT_HASH=PLACEHOLDER_PLEASE_REBUILD" >> \
            ${IMAGE_ROOTFS}${datadir}/misc/dm-verity.env
    fi
}
IMAGE_PREPROCESS_COMMAND += "deploy_verity_hash;"
