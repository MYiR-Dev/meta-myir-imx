# linux-fit-tee.inc
# FIT Image + OP-TEE integration for i.MX6ULL
#
# Injects the OP-TEE binary as a loadable into the fitImage ITS so that
# bootm can load OP-TEE alongside the kernel.  This is used exclusively
# in the FIT+HAB+TEE boot scheme (MYIR_HAB_TEE_MODE="fit").
#
# How it works:
#   1. do_assemble_fitimage is the standard kernel-fitimage task that
#      calls fitimage_assemble() — a shell function that generates
#      fit-image.its and runs mkimage in one shot.
#   2. do_assemble_fitimage:append runs AFTER fitimage_assemble completes:
#      a) Copies tee-raw.bin from DEPLOY_DIR_IMAGE/optee/ → ${B}/tee.bin (no OPTEE header)
#      b) Runs inject-tee-its.py to add a tee-1 node + loadables to ITS
#      c) Re-runs mkimage to produce the final fitImage-none with TEE
#   3. myir-fit-habv4-sign.bbclass then signs it with HABv4 (same as
#      the plain FIT path — TEE is embedded, so IVT is at the end).
#
# Guard: mx6ull-generic-bsp override ensures zero impact on MX9/MX95.

FILESEXTRAPATHS:prepend := "${THISDIR}/files:"
SRC_URI:append:mx6ull-generic-bsp = " file://inject-tee-its.py"

# Ensure OP-TEE is deployed before we try to assemble the fitImage
do_assemble_fitimage[depends] += " \
    ${@bb.utils.contains('MYIR_HAB_TEE_MODE', 'fit', 'optee-os:do_deploy', '', d)} \
"

# Inject TEE into the fitImage after mkimage builds the unsigned image
do_assemble_fitimage:append:mx6ull-generic-bsp() {
    if [ "${MYIR_HAB_TEE_MODE}" != "fit" ]; then
        return 0
    fi
    if ! echo ${KERNEL_IMAGETYPES} | grep -wq "fitImage"; then
        return 0
    fi

    bbnote "FIT+TEE: Injecting OP-TEE into fitImage ITS..."

    # Locate OP-TEE binary (deployed by optee-os recipe)
    TEE_DEPLOY_DIR="${DEPLOY_DIR_IMAGE}/optee"
    TEE_BIN="$TEE_DEPLOY_DIR/tee-raw.bin"
    if [ ! -f "$TEE_BIN" ]; then
        bbfatal "FIT+TEE: OP-TEE binary not found at $TEE_BIN"
    fi

    # Copy to build directory (ITS incbin path is relative to ${B})
    cp "$TEE_BIN" ${B}/tee.bin
    TEE_SIZE=$(stat -c%s ${B}/tee.bin)
    bbnote "FIT+TEE: tee-raw.bin copied (size=$TEE_SIZE bytes)"

    # Inject TEE node into the ITS generated by fitimage_assemble
    cd ${B}
    if [ ! -f fit-image.its ]; then
        bbfatal "FIT+TEE: fit-image.its not found in ${B}"
    fi

    python3 ${UNPACKDIR}/inject-tee-its.py fit-image.its \
        tee-1 0x84000000 ./tee.bin || \
        bbfatal "FIT+TEE: Failed to inject TEE node into ITS"

    # Rebuild fitImage with the modified ITS
    bbnote "FIT+TEE: Rebuilding fitImage with TEE loadable..."
    ${UBOOT_MKIMAGE} \
        -f fit-image.its \
        ${KERNEL_OUTPUT_DIR}/fitImage-none || \
        bbfatal "FIT+TEE: mkimage failed"

    # Re-sign the fitImage with FIT RSA keys.
    # The original signing by fitimage_assemble() is invalidated because
    # we rebuilt the image with TEE.  Without this step, the signature
    # nodes have structure but no hash/signature values, causing U-Boot's
    # fit_config_check_sig() to fail with "Can't get hash value property".
    if [ "${UBOOT_SIGN_ENABLE}" = "1" ]; then
        bbnote "FIT+TEE: Re-signing fitImage (RSA) with TEE loadable..."
        ${UBOOT_MKIMAGE_SIGN} \
            -F -k "${UBOOT_SIGN_KEYDIR}" \
            -r ${KERNEL_OUTPUT_DIR}/fitImage-none \
            ${UBOOT_MKIMAGE_SIGN_ARGS} || \
            bbfatal "FIT+TEE: RSA re-signing failed"
    fi

    bbnote "FIT+TEE: fitImage with OP-TEE built successfully"
}
