#!/bin/sh
# ---------------------------------------------------------------------------
# dmverity-overlay — MYIR enhanced dm-verity initramfs module
#
# Based on NXP meta-security-imx-dmverity dmverity-overlay (lf-6.18.y-1.0.0).
# Aligned with NXP: veritysetup open (vs deprecated create), noload mount,
# overlay partition number validation.
#
# This module handles the complete dm-verity + overlayfs boot flow:
#   1. Device readiness wait with configurable timeout
#   2. Root hash signature verification (openssl, if enabled)
#   3. dm-verity device mapping (with/without separate hash partition)
#   4. Rootfs mount (read-only, noload for ext4 journal skip)
#   5. Overlayfs setup on /etc, /root, /var (if enabled)
#   6. Hands off to the rootfs module
#
# Features controlled via dm-verity.env variables:
#   - SEPARATE_HASH:   0 = hash at end of rootfs, 1 = separate hash partition
#   - MYIR_OVERLAY:    0 = no overlay, 1 = overlay enabled
#   - MYIR_SIGN_ROOTHASH: 0 = no verification, 1 = verify with openssl
#
# Kernel command-line parameters:
#   rootdelay=N     — initial sleep in seconds (default: 1)
#   roottimeout=N   — max wait time in seconds (default: 30)
#   rootrw=UUID=... — overlay partition UUID (for rootrw kernel param)
# ---------------------------------------------------------------------------

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

dmverity_msg() {
    echo "dmverity-overlay: $*" >&2
}

dmverity_fatal() {
    dmverity_msg "FATAL: $*"
    exit 1
}

# ---------------------------------------------------------------------------
# Check if we should handle this boot
# ---------------------------------------------------------------------------
dmverity_enabled() {
    # Only activate if dm-verity.env exists (indicates dm-verity rootfs)
    if [ ! -f /usr/share/misc/dm-verity.env ]; then
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------
dmverity_run() {
    # ---- Load verity parameters ----
    DATA_SIZE="__not_set__"
    DATA_BLOCK_SIZE="__not_set__"
    ROOT_HASH="__not_set__"
    SEPARATE_HASH="__not_set__"
    RHASH_UUID="__not_set__"
    ROOT_UUID="__not_set__"

    . /usr/share/misc/dm-verity.env

    # Defaults for MYIR-specific variables (backward compat)
    MYIR_OVERLAY="${MYIR_OVERLAY:-0}"
    MYIR_SIGN_ROOTHASH="${MYIR_SIGN_ROOTHASH:-0}"

    # ---- Timing parameters ----
    delay=${bootparam_rootdelay:-1}
    timeout=${bootparam_roottimeout:-30}

    # ====================================================================
    # STEP 1: Wait for rootfs block device
    # ====================================================================
    dmverity_msg "Waiting for rootfs block device..."

    C=0
    if [ "${SEPARATE_HASH}" = "1" ]; then
        # Separate hash mode: wait for both data and hash partitions
        while [ ! -b "/dev/disk/by-partuuid/${ROOT_UUID}" ] || \
              [ ! -b "/dev/disk/by-partuuid/${RHASH_UUID}" ]; do
            if [ $(( C * delay )) -gt $timeout ]; then
                dmverity_fatal "Root data/hash devices not found after ${timeout}s"
            fi
            dmverity_msg "  ...waiting for data+hash devices (${C}s)"
            sleep $delay
            C=$(( C + 1 ))
        done

        dmverity_msg "Root data device: /dev/disk/by-partuuid/${ROOT_UUID}"
        dmverity_msg "Hash device:       /dev/disk/by-partuuid/${RHASH_UUID}"
    else
        # Inline hash mode: find root device
        RDEV="$(realpath /dev/disk/by-partuuid/${bootparam_root#PARTUUID=} 2>/dev/null)"

        while [ ! -b "${RDEV}" ]; do
            if [ $(( C * delay )) -gt $timeout ]; then
                dmverity_fatal "Root device not found after ${timeout}s"
            fi

            case "${bootparam_root}" in
                ID=*)
                    RDEV="$(realpath /dev/disk/by-id/${bootparam_root#ID=} 2>/dev/null)" ;;
                LABEL=*)
                    RDEV="$(realpath /dev/disk/by-label/${bootparam_root#LABEL=} 2>/dev/null)" ;;
                PARTLABEL=*)
                    RDEV="$(realpath /dev/disk/by-partlabel/${bootparam_root#PARTLABEL=} 2>/dev/null)" ;;
                PARTUUID=*)
                    RDEV="$(realpath /dev/disk/by-partuuid/${bootparam_root#PARTUUID=} 2>/dev/null)" ;;
                PATH=*)
                    RDEV="$(realpath /dev/disk/by-path/${bootparam_root#PATH=} 2>/dev/null)" ;;
                UUID=*)
                    RDEV="$(realpath /dev/disk/by-uuid/${bootparam_root#UUID=} 2>/dev/null)" ;;
                *)
                    RDEV="${bootparam_root}" ;;
            esac

            dmverity_msg "  ...waiting for root device (${C}s)"
            sleep $delay
            C=$(( C + 1 ))
        done
    fi

    dmverity_msg "Root device ready (after ${C}s)"

    # ====================================================================
    # STEP 2: Verify root hash signature (if enabled)
    # ====================================================================
    if [ "${MYIR_SIGN_ROOTHASH}" = "1" ]; then
        dmverity_msg "Verifying root hash signature..."

        if [ ! -f /usr/share/misc/dm-verity-public.pem ]; then
            dmverity_fatal "Public key not found: /usr/share/misc/dm-verity-public.pem"
        fi
        if [ ! -f /usr/share/misc/dm-verity-roothash.sig ]; then
            dmverity_fatal "Root hash signature not found: /usr/share/misc/dm-verity-roothash.sig"
        fi

        # Verify: openssl dgst -sha256 -verify pubkey -signature sig file
        echo -n "${ROOT_HASH}" | openssl dgst -sha256 \
            -verify /usr/share/misc/dm-verity-public.pem \
            -signature /usr/share/misc/dm-verity-roothash.sig

        if [ $? -ne 0 ]; then
            dmverity_fatal "Root hash signature verification FAILED! Possible tampering detected."
        fi
        dmverity_msg "Root hash signature verified OK"
    else
        dmverity_msg "Root hash signature verification: SKIPPED (not enabled)"
    fi

    # ====================================================================
    # STEP 3: Setup dm-verity device mapping (veritysetup open — NXP-aligned)
    # ====================================================================
    dmverity_msg "Setting up dm-verity device..."

    if [ "${SEPARATE_HASH}" = "1" ]; then
        veritysetup \
            --data-block-size=${DATA_BLOCK_SIZE} \
            open \
            /dev/disk/by-partuuid/${ROOT_UUID} \
            rootfs \
            /dev/disk/by-partuuid/${RHASH_UUID} \
            ${ROOT_HASH}
    else
        veritysetup \
            --data-block-size=${DATA_BLOCK_SIZE} \
            --hash-offset=${DATA_SIZE} \
            open \
            ${RDEV} \
            rootfs \
            ${RDEV} \
            ${ROOT_HASH}
    fi

    if [ $? -ne 0 ]; then
        dmverity_fatal "veritysetup failed — root hash mismatch or device error"
    fi

    dmverity_msg "dm-verity device /dev/mapper/rootfs created"

    # ====================================================================
    # STEP 4: Mount rootfs (read-only, noload — NXP-aligned for ext4)
    # ====================================================================
    dmverity_msg "Mounting rootfs (dm-verity + ro,noload)..."

    mount -o ro,noload /dev/mapper/rootfs ${ROOTFS_DIR}
    if [ $? -ne 0 ]; then
        dmverity_msg "WARNING: ro,noload mount failed, retrying with ro only..."
        mount -o ro /dev/mapper/rootfs ${ROOTFS_DIR}
        if [ $? -ne 0 ]; then
            dmverity_fatal "Failed to mount rootfs at ${ROOTFS_DIR}"
        fi
    fi

    dmverity_msg "Rootfs mounted at ${ROOTFS_DIR}"

    # ====================================================================
    # STEP 5: Setup overlayfs (if enabled)
    # ====================================================================
    if [ "${MYIR_OVERLAY}" = "1" ]; then
        dmverity_msg "Setting up overlayfs..."

        # Determine overlay partition device
        OVERLAY_DEV=""

        if [ -n "${bootparam_rootrw}" ]; then
            # rootrw= specified on kernel command line
            case "${bootparam_rootrw}" in
                UUID=*)
                    OVERLAY_DEV="$(realpath /dev/disk/by-uuid/${bootparam_rootrw#UUID=} 2>/dev/null)"
                    ;;
                LABEL=*)
                    OVERLAY_DEV="$(realpath /dev/disk/by-label/${bootparam_rootrw#LABEL=} 2>/dev/null)"
                    ;;
                PARTUUID=*)
                    OVERLAY_DEV="$(realpath /dev/disk/by-partuuid/${bootparam_rootrw#PARTUUID=} 2>/dev/null)"
                    ;;
                PARTLABEL=*)
                    OVERLAY_DEV="$(realpath /dev/disk/by-partlabel/${bootparam_rootrw#PARTLABEL=} 2>/dev/null)"
                    ;;
                PATH=*)
                    OVERLAY_DEV="$(realpath /dev/disk/by-path/${bootparam_rootrw#PATH=} 2>/dev/null)"
                    ;;
                *)
                    OVERLAY_DEV="${bootparam_rootrw}"
                    ;;
            esac
        fi

        # Auto-detect: if rootrw= not specified or didn't resolve, try
        # common overlay partition labels (LABEL=overlay).
        if [ -z "${OVERLAY_DEV}" ] || [ ! -b "${OVERLAY_DEV}" ]; then
            dmverity_msg "rootrw= not specified or not found, auto-detecting..."
            for lbl in overlay data; do
                dev="$(realpath /dev/disk/by-label/${lbl} 2>/dev/null)"
                if [ -n "${dev}" ] && [ -b "${dev}" ]; then
                    OVERLAY_DEV="${dev}"
                    dmverity_msg "  auto-detected overlay: ${OVERLAY_DEV} (LABEL=${lbl})"
                    break
                fi
            done
        fi

        # Graceful degradation: if no overlay partition found, boot read-only
        if [ -z "${OVERLAY_DEV}" ] || [ ! -b "${OVERLAY_DEV}" ]; then
            dmverity_msg "WARNING: No overlay partition found (rootrw=${bootparam_rootrw:-<empty>})"
            dmverity_msg "WARNING: Booting read-only without overlayfs"
            dmverity_msg "WARNING: /etc, /root, /var will be read-only"
            dmverity_msg "dm-verity boot completed (read-only, no overlay)"
            return 0
        fi

        dmverity_msg "Overlay device: ${OVERLAY_DEV}"

        # -------------------------------------------------------------------
        # Validate overlay partition number (NXP alignment)
        # Must not be boot(1), rootfs(2), or hash partition(3)
        # Uses /sys/class/block/.../partition — more robust than NXP's ls -l
        # -------------------------------------------------------------------
        overlay_devname=$(basename $(readlink -f ${OVERLAY_DEV}))
        if [ -f "/sys/class/block/${overlay_devname}/partition" ]; then
            part_num=$(cat /sys/class/block/${overlay_devname}/partition)
            if [ "${part_num}" = "1" ] || [ "${part_num}" = "2" ]; then
                dmverity_fatal "Overlay partition ${part_num} conflicts with boot/rootfs"
            fi
            if [ "${SEPARATE_HASH}" = "1" ] && [ "${part_num}" = "3" ]; then
                dmverity_fatal "Overlay partition ${part_num} conflicts with hash partition"
            fi
            dmverity_msg "Overlay partition number: ${part_num} (valid)"
        else
            dmverity_msg "WARNING: cannot determine overlay partition number"
        fi

        # Mount overlay partition
        mkdir -p /overlay
        mount ${OVERLAY_DEV} /overlay
        if [ $? -ne 0 ]; then
            dmverity_msg "WARNING: Failed to mount overlay partition ${OVERLAY_DEV}"
            dmverity_msg "WARNING: Booting read-only without overlayfs"
            dmverity_msg "dm-verity boot completed (read-only, overlay mount failed)"
            return 0
        fi

        # Create upper/work directories for each overlay target
        OVERLAY_DIRS="/etc /root /var"
        for dir in ${OVERLAY_DIRS}; do
            upper_dir="/overlay/upper${dir}"
            work_dir="/overlay/work${dir}"
            target_dir="${ROOTFS_DIR}${dir}"

            mkdir -p "${upper_dir}" "${work_dir}"

            # Verify lower directory exists
            if [ ! -d "${target_dir}" ]; then
                mkdir -p "${target_dir}"
            fi

            mount -t overlay overlay_${dir#/} \
                -o lowerdir=${target_dir},upperdir=${upper_dir},workdir=${work_dir} \
                ${target_dir}

            if [ $? -ne 0 ]; then
                dmverity_fatal "Failed to setup overlay for ${dir}"
            fi
            dmverity_msg "  overlayfs on ${target_dir} OK"
        done

        dmverity_msg "Overlayfs setup complete on ${OVERLAY_DIRS}"
    fi

    dmverity_msg "dm-verity boot completed successfully"
}
