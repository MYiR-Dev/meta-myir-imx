# i.MX95 AHAB (Advanced High Assurance Boot) CSF Template
#
# This CSF (Command Sequence File) is used by NXP CST tool to sign
# the flash.bin image for i.MX95 processors. The AHAB container format
# is validated by the ELE (EdgeLock Enclave) during boot.
#
# Target:  AHAB v2.0 (i.MX95)
# Keys:    ECC secp384r1 minimum
# Digest:  SHA-384
#
# The following placeholders are substituted by mx95_gen_csf.py:
#   @@MYIR_AHAB_SRK_TABLE@@      -> SRK table binary path
#   @@MYIR_AHAB_SRK_CERT@@       -> SRK certificate PEM path
#   @@MYIR_AHAB_SRK_SOURCE_IDX@@ -> SRK source index (0-based, 0-3)
#   @@MYIR_AHAB_SGK_CERT@@       -> SGK certificate PEM path (optional)
#   @@FLASH_BIN_PATH@@           -> Container binary to sign
#   @@CONTAINER_OFFSET@@         -> Container header offset (hex)
#   @@SIGNATURE_OFFSET@@         -> Signature block offset (hex)

[Header]
Target = AHAB
Version = 2.0

[Install SRK]
# SRK table generated by srktool (NXP CST)
# Contains hash of all 4 SRK public keys
File = "@@MYIR_AHAB_SRK_TABLE@@"

# Public key certificate in PEM format
# This is the SRK certificate used to verify the boot image signature
Source = "@@MYIR_AHAB_SRK_CERT@@"

# Index of this SRK within the SRK table (0-based, 0..3)
Source index = @@MYIR_AHAB_SRK_SOURCE_IDX@@

# Type of SRK set: OEM (customer-owned) or NXP
Source set = OEM

# Bitmask of revoked SRKs (0 = none revoked)
Revocations = 0x0

#+START_SGK_BLOCK (this block is removed if MYIR_AHAB_USE_SGK is not 1)
# Optional subordinate SGK (Super Root Key child key)
# When enabled, the SGK signs the actual boot images, providing
# key rotation capability without modifying the SRK fuses.
[Install Certificate]
# SGK public key certificate in PEM format
File = "@@MYIR_AHAB_SGK_CERT@@"

# Permission bitmask:
#   0x1 = SGK is allowed to sign boot images
Permissions = 0x1

#+END_SGK_BLOCK

[Authenticate Data]
# Binary to be signed - the flash.bin generated by imx-mkimage
# This contains the full boot image (SECO/ELE FW, ATF, U-Boot, etc.)
File = "@@FLASH_BIN_PATH@@"

# Container offset mapping:
#   Offset 1 = Container header  (where AHAB container starts)
#   Offset 2 = Signature block   (where CST writes the signature)
# These offsets are printed by imx-mkimage during flash.bin generation.
Offsets = @@CONTAINER_OFFSET@@             @@SIGNATURE_OFFSET@@
